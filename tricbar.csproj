<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>TricBar - Transparent and centralized taskbar</AssemblyTitle>
    <Product>TricBar</Product>
    <Company>Superplex</Company>
    <Description>Transparent and centralized taskbar for Windows 10</Description>
    <Version>1.0.2</Version>
    <Copyright>© 2026 Superplex</Copyright>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
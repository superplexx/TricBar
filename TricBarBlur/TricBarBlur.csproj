<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>TricBarBlur</AssemblyName>
    <RootNamespace>TricBar</RootNamespace>
    <AssemblyTitle>TricBar</AssemblyTitle>
    <Product>TricBar</Product>
    <Company>Superplex</Company>
    <Description>TricBar engine - taskbar transparency, blur, acrylic and color</Description>
    <Version>3.1.5</Version>
    <Copyright>© 2026 Superplex</Copyright>
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
